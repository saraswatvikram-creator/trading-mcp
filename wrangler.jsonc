{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trading-mcp",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp", "/login", "/callback", "/auth/*", "/fivepaisa/callback"]
  },
  "kv_namespaces": [
    {
      "binding": "ZERODHA_TOKEN_STORE",
      "id": "7845396b867f458f96aa96eec2b550e8"
    }
  ],
  "previews": {}
}
